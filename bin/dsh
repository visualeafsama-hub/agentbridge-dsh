#!/bin/sh
# dsh wrapper — bare `dsh` / `dsh web` TAKES OVER the web GUI on the port:
# any existing (foreign / orphaned) instance is stopped, then `dsh web` runs
# in the FOREGROUND so the terminal holds the process (Ctrl-C stops it, like
# `abg dsh`). A background child opens the chromium app window once the GUI
# answers. The MCP bridge stays with `abg dsh --pair X`. Any other
# invocation passes through to the real dsh.
#
# Installed by install.sh (default: ~/.bun/bin/dsh). Self-locating: finds
# the real dsh on PATH and skips itself, so any install path works.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"

find_real_dsh() {
  IFS=:
  for d in $PATH; do
    [ -n "$d" ] || d=.
    if [ -x "$d/dsh" ]; then
      rp="$(readlink -f "$d/dsh" 2>/dev/null || echo "$d/dsh")"
      if [ "$rp" != "$SELF" ]; then
        echo "$d/dsh"
        return 0
      fi
    fi
  done
  return 1
}

REAL_DSH="$(find_real_dsh)"
if [ -z "$REAL_DSH" ]; then
  echo "dsh: real dsh not found on PATH" >&2
  exit 1
fi

RUN_DIR="${ABG_RUN_DIR:-$HOME/agentbridge-dsh/run}"
WEB_URL="${ABG_DSH_WEB_URL:-http://127.0.0.1:3080}"
CHROMIUM="${ABG_CHROMIUM_CMD:-chromium}"

# Derive the port from WEB_URL (default 80 when absent).
WEB_PORT="$(printf '%s' "$WEB_URL" | sed -n 's#^https\?://[^:/]*:\([0-9]*\).*#\1#p')"
[ -z "$WEB_PORT" ] && WEB_PORT=80

wait_for_web() {
  i=0
  until curl -sf -o /dev/null "$WEB_URL/" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge 120 ] && return 1
    sleep 1
  done
  return 0
}

ensure_chrome() {
  CHROME_PID=""
  [ -f "$RUN_DIR/chromium.pid" ] && CHROME_PID=$(cat "$RUN_DIR/chromium.pid")
  if [ -n "$CHROME_PID" ] && kill -0 "$CHROME_PID" 2>/dev/null && tr '\0' ' ' < "/proc/$CHROME_PID/cmdline" 2>/dev/null | grep -q -- "--app=$WEB_URL"; then
    echo "dsh: chromium window already open (pid $CHROME_PID, skip)"
    return 0
  fi
  nohup "$CHROMIUM" --incognito "--app=$WEB_URL" >> "$RUN_DIR/chromium" 2>&1 &
  echo $! > "$RUN_DIR/chromium.pid"
  echo "dsh: opened chromium window -> $WEB_URL"
}

# Stop whatever currently serves the port so the foreground below is the one
# and only holder (orphans from earlier detached runs are reclaimed).
take_over_web() {
  if ! curl -sf -o /dev/null "$WEB_URL/" 2>/dev/null; then
    return 0
  fi
  local OLD
  OLD="$(lsof -ti :"$WEB_PORT" -sTCP:LISTEN 2>/dev/null | head -1)"
  if [ -z "$OLD" ]; then
    echo "dsh: note: web is answering but owner not found (lsof); starting may fail if the port is busy" >&2
    return 0
  fi
  echo "dsh: stopping existing web instance (pid $OLD) to take over the GUI"
  kill "$OLD" 2>/dev/null
  if [ -f "$RUN_DIR/chromium.pid" ]; then
    kill "$(cat "$RUN_DIR/chromium.pid")" 2>/dev/null
  fi
  i=0
  while curl -sf -o /dev/null "$WEB_URL/" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge 30 ] && break
    sleep 1
  done
}

boot_web_chrome() {
  mkdir -p "$RUN_DIR"
  take_over_web
  # Chromium opener: survives the foreground web below, opens the window as
  # soon as the GUI answers.
  ( wait_for_web && ensure_chrome ) &
  # Foreground: the terminal holds the web process — Ctrl-C stops it.
  "$REAL_DSH" web
  RC=$?
  # Close the chromium window we opened (same semantics as `abg dsh` Ctrl-C).
  if [ -f "$RUN_DIR/chromium.pid" ]; then
    kill "$(cat "$RUN_DIR/chromium.pid")" 2>/dev/null
  fi
  exit $RC
}

case "$1" in
  "")
    boot_web_chrome
    exit 0
    ;;
  web)
    shift
    if [ "$#" -eq 0 ]; then
      boot_web_chrome
      exit 0
    fi
    exec "$REAL_DSH" web "$@"
    ;;
  *)
    exec "$REAL_DSH" "$@"
    ;;
esac